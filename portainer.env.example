# MATEbot Portainer example environment file
#
# Load this file in Portainer:
# Stack -> Environment variables -> Load variables from .env file
#
# IMPORTANT:
# 192.168.1.100 is an EXAMPLE private LAN address.
# Replace it with the actual IP address or hostname of your GaggiMate.
# A DHCP reservation/static IP is recommended.

TZ=Europe/Budapest

# GaggiMate
MATEBOT_MACHINE_HOST=192.168.1.100

# Persistent MATEbot state
MATEBOT_DATA_PATH=/mnt/ssd/matebot

# Telegram secret files on the Docker host.
# Do NOT put the actual bot token in this .env file.
MATEBOT_TELEGRAM_TOKEN_PATH=/mnt/ssd/secrets/telegram_token
MATEBOT_TELEGRAM_CHAT_ID_PATH=/mnt/ssd/secrets/telegram_chat_id

# MATEbot behavior
MATEBOT_HINTS=1
MATEBOT_MIN_SHOT_S=10
MATEBOT_IGNORE_PROFILES=(?i)backflush|descale|flush|clean

# Container resource limits
MATEBOT_MEM_LIMIT=256m
MATEBOT_CPU_LIMIT=0.50
