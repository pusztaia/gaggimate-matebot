@@ -0,0 +1,103 @@
+import asyncio
+from types import SimpleNamespace
+
+from matebot.commands import CommandRouter
+
+
+class FakeClient:
+    def __init__(self):
+        self.items = [
+            {
+                "id": "one", "label": "Profile One", "type": "pro",
+                "favorite": True, "selected": True, "utility": False,
+                "temperature": 93,
+                "phases": [{"name": "Brew", "duration": 20}],
+            },
+            {
+                "id": "two", "label": "Profile Two", "type": "pro",
+                "favorite": True, "selected": False, "utility": False,
+                "temperature": 94, "phases": [],
+            },
+        ]
+
+    async def profiles_list(self):
+        return [dict(x) for x in self.items]
+
+    async def profile_load(self, profile_id):
+        return next(dict(x) for x in self.items if x["id"] == profile_id)
+
+    async def profile_select(self, profile_id):
+        for x in self.items:
+            x["selected"] = x["id"] == profile_id
+
+
+class FakeMessenger:
+    def __init__(self):
+        self.sent = []
+        self.edited = []
+
+    async def send(self, text, options=None):
+        self.sent.append((text, options or []))
+        return str(len(self.sent))
+
+    async def edit(self, ref, text, options=None):
+        self.edited.append((ref, text, options or []))
+
+
+class FakeState:
+    def get(self, key, default=None):
+        return default
+
+    def set(self, key, value):
+        pass
+
+
+class FakeConvo:
+    async def skip(self):
+        return False
+
+
+def latest_idle():
+    return ({"tp": "evt:status", "m": 1, "process": {"a": 0}}, 0.1)
+
+
+def latest_brewing():
+    return ({"tp": "evt:status", "m": 1, "process": {"a": 1}}, 0.1)
+
+
+def router(latest=latest_idle):
+    messenger = FakeMessenger()
+    cfg = SimpleNamespace(
+        data_repo=None,
+        journal_url=None,
+        wake_hook=None,
+        sleep_hook=None,
+        water_warn_pct=0,
+        autoheat_window=None,
+    )
+    return (
+        CommandRouter(FakeClient(), FakeState(), FakeConvo(), messenger, cfg, latest),
+        messenger,
+    )
+
+
+def test_profiles_command_and_select_callback():
+    r, m = router()
+    assert asyncio.run(r.handle("/profiles"))
+    assert "GaggiMate Profiles" in m.sent[-1][0]
+    assert any(o.id == "pf|s|two" for o in m.sent[-1][1])
+    assert asyncio.run(r.handle_option("pf|s|two"))
+    assert m.edited
+    assert "Profile selected: Profile Two" in m.edited[-1][1]
+
+
+def test_profile_button_is_consumed_before_conversation():
+    r, _ = router()
+    assert asyncio.run(r.handle_option("pf|r|0"))
+
+
+def test_selection_blocked_during_brew():
+    r, m = router(latest_brewing)
+    asyncio.run(r.handle("/profiles"))
+    asyncio.run(r.handle_option("pf|s|two"))
+    assert "currently in progress" in m.sent[-1][0]
